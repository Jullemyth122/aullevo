{
  "manifest_version": 3,
  "name": "Aullevo - AI Form Autofill & Job Application Filler",
  "short_name": "Aullevo",
  "version": "0.6.0",
  "description": "AI form filler for job applications, surveys, and any web form. Saved profiles, resume upload, and smart autofill.",
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_title": "Open Aullevo Side Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Toggle Aullevo Side Panel"
    },
    "trigger-ai-fill": {
      "suggested_key": {
        "default": "Alt+Shift+L",
        "mac": "Option+Shift+L"
      },
      "description": "Trigger AI or Keyword Form Autofill on Page"
    },
    "trigger-batch-fill": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Option+Shift+B"
      },
      "description": "Trigger Multi-Link Batch Form Autofill"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
