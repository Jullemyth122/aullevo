# Copy to .env. Only the project ID is used by the extension (to verify sign-in tokens
# from aullevo-web against Firestore). Not a secret.
VITE_FIREBASE_PROJECT_ID=aullevo-data

# Hosted AI proxy (leave empty until the server exists; users can still use their own Gemini key)
VITE_AULLEVO_AI_PROXY_URL=
